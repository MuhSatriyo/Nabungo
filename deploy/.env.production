# ==========================================
# Nabungo Production Environment Variables
# ==========================================

# ---- App ----
NODE_ENV=production
APP_NAME=Nabungo
APP_URL=https://api.nabungo.app

# ---- Server ----
PORT=3000

# ---- Database ----
DB_HOST=nabungo-db
DB_PORT=5432
DB_NAME=nabungo
DB_USER=nabungo
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
BACKUP_PASSWORD=CHANGE_ME_BACKUP_PASSWORD_32_CHARS

# ---- Database Pool Configuration ----
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ---- JWT ----
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_64_CHARS_LONG_FOR_SECURITY
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_64_CHARS_LONG_FOR_SECURITY
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS ----
CORS_ORIGIN=https://nabungo.app,https://api.nabungo.app

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Backup ----
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=nabungo-backups
