# ==========================================
# Nabungo Environment Variables Example
# ==========================================
# Copy this to .env.production and fill values

# ---- App ----
NODE_ENV=production
APP_NAME=Nabungo
APP_URL=https://api.nabungo.app

# ---- Server ----
PORT=3000

# ---- Database ----
DB_HOST=nabungo-db
DB_PORT=5432
DB_NAME=nabungo
DB_USER=nabungo
DB_PASSWORD=your_strong_db_password_here
BACKUP_PASSWORD=your_strong_backup_password_here

# ---- JWT ----
JWT_SECRET=your_jwt_secret_min_64_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS ----
CORS_ORIGIN=https://nabungo.app,https://api.nabungo.app

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Backup ----
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=nabungo-backups
